# Backend
APP_NAME=TrafficIQ
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://traffiq:change-me@localhost:5432/traffiq
# Optional local-only fallback: sqlite:///./traffiq_dev.db
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
TRACKING_RATE_LIMIT_PER_MINUTE=120
# Generate a long random value before deployment
TRACKING_SIGNING_SECRET=replace-this-before-deployment
